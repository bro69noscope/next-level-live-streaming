{
  "compilerOptions": {
    "paths": {
      "https://repo.local/external/common/helpers/js/*": [
        "../common/helpers/js/*"
      ]
    },
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "outDir": "./wwwroot",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../common/helpers/js" }]
}

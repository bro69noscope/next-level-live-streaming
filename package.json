{
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "json5": "^2.2.3"
  },
  "scripts": {
    "build:js-helpers": "node external/common/helpers/js/build-js-helpers.mjs",
    "build:alerts-overlays": "node scripts/tasks.mjs build alerts-overlays",
    "build:streamfeed": "node scripts/tasks.mjs build streamfeed",
    "build:ts": "tsc -b && npm run build:js-helpers",
    "build:all": "npm run build:ts && npm run setup:ps1",
    "watch:ts": "tsc -b --watch",
    "watch:all": "node scripts/tasks.mjs watch",
    "serve:alerts-overlays": "node scripts/tasks.mjs serve alerts-overlays",
    "serve:all": "node scripts/tasks.mjs serve",
    "dev:alerts-overlays": "node scripts/tasks.mjs dev alerts-overlays",
    "dev:all": "node scripts/tasks.mjs dev",
    "weztab:alerts-overlays": "node scripts/tasks.mjs weztab alerts-overlays",
    "weztab:all": "node scripts/tasks.mjs weztab",
    "setup:ps1": "pwsh -File ./external/common/helpers/ps1/install-all.ps1",
    "setup:git": "git config include.path ../.gitconfig",
    "postinstall": "npm run setup:git && npm run setup:ps1",
    "clean:ts": "tsc -b --clean"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
